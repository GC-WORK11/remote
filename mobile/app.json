{
  "expo": {
    "name": "Remote",
    "slug": "remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.gcwork11.remote"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F4F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "io.github.gcwork11.remote",
      "blockedPermissions": [
        "SYSTEM_ALERT_WINDOW",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Remote uses the camera to scan the pairing QR your computer shows (ompr pair)."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Remote uses the mic for voice input \u2014 dictation fills the composer.",
          "speechRecognitionPermission": "Remote transcribes your voice into the composer text field."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4F1"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "#F6F4F1",
          "translucent": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#34A853"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "remote"
  }
}