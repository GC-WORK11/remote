+/**
+ * Bound on waiting out background model discovery: a wedged provider (dead
+ * OAuth refresh, hung endpoint) can stall `awaitBackgroundRefresh` for tens
+ * of seconds, and RPC commands serialize behind it — an unbounded wait makes
+ * the whole channel look frozen. Past the budget the registry serves whatever
+ * catalog it already has; late providers still land for the next call.
+ */
+const MODEL_DISCOVERY_WAIT_MS = 8_000;
+
+async function awaitModelDiscoveryBounded(session: AgentSession): Promise<void> {
+	await Promise.race([session.modelRegistry.awaitBackgroundRefresh(), Bun.sleep(MODEL_DISCOVERY_WAIT_MS)]);
+}
