+export interface OpenAIImageFallbackState {
+	images: {
+		disabledModelScopes: Set<string>;
+	};
+}
+
+export function createOpenAIImageFallbackState(): OpenAIImageFallbackState {
+	return {
+		images: {
+			disabledModelScopes: new Set<string>(),
+		},
+	};
+}
+
+export function clearOpenAIImageFallbackState(state: OpenAIImageFallbackState): void {
+	state.images.disabledModelScopes.clear();
+}
+
+export function isImagesDisabledForScope(
+	state: OpenAIImageFallbackState | undefined,
+	scope: OpenAIStrictToolsScope | undefined,
+): boolean {
+	if (!scope) return false;
+	return state?.images.disabledModelScopes.has(`${scope.provider}:${scope.baseUrl ?? ""}:${scope.modelId}`) ?? false;
+}
+
+export function disableImagesForScope(
+	state: OpenAIImageFallbackState | undefined,
+	scope: OpenAIStrictToolsScope | undefined,
+): void {
+	if (!scope) return;
+	state?.images.disabledModelScopes.add(`${scope.provider}:${scope.baseUrl ?? ""}:${scope.modelId}`);
+}
