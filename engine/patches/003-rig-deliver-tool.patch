diff --git a/packages/coding-agent/src/tools/rig-deliver.ts b/packages/coding-agent/src/tools/rig-deliver.ts
new file mode 100644
index 0000000..4de574f
--- /dev/null
+++ b/packages/coding-agent/src/tools/rig-deliver.ts
@@ -0,0 +1,106 @@
+import { type } from "@oh-my-pi/omptype";
+import type { AgentTool, AgentToolResult, AgentToolUpdateCallback } from "@oh-my-pi/pi-agent-core";
+import type { TextContent } from "@oh-my-pi/pi-ai";
+import { prompt } from "@oh-my-pi/pi-utils";
+import rigDeliverDescription from "../prompts/tools/rig-deliver.md" with { type: "text" };
+import type { ToolSession } from ".";
+import { bridgeFromEnv } from "./rig-computer";
+import { throwIfAborted } from "./tool-errors";
+
+/**
+ * rig_deliver — hand a file that lives on the rig to the user's phone.
+ *
+ * Same loopback bridge as rig_computer: omprd injects OMPD_WS + OMPD_TOKEN
+ * into every spawned omp child; absent those, the tool stays unregistered so
+ * the schema never reaches the model. The tool verifies the path through
+ * rig.fs.stat, then returns a `{"type":"rig.deliver", ...}` text payload —
+ * the Remote app detects that marker in the tool result (same channel the
+ * computer.observe shots ride) and renders a download card in the thread:
+ * tap → rig.fs.read → bytes land on the phone and open the share sheet.
+ * Nothing is pushed anywhere; the phone pulls on demand.
+ */
+
+type JsonObj = Record<string, unknown>;
+
+const rigDeliverSchema = type({
+	path: type("string").describe("absolute path of the file to hand to the phone"),
+	"caption?": type("string").describe("one line shown under the file card, e.g. 'Q3 deck'"),
+	"cwd?": type("string").describe("resolve a relative path against this directory"),
+});
+type RigDeliverParams = typeof rigDeliverSchema.infer;
+
+interface RigDeliverDetails {
+	path: string;
+	ok: boolean;
+	reply: JsonObj;
+}
+
+export class RigDeliverTool implements AgentTool<typeof rigDeliverSchema, RigDeliverDetails> {
+	readonly name = "rig_deliver";
+	readonly label = "Deliver File";
+	readonly summary = "Send a file on this rig to the user's phone chat";
+	readonly description = prompt.render(rigDeliverDescription);
+	readonly parameters = rigDeliverSchema;
+	readonly strict = true;
+	readonly interruptible = true;
+	// File bytes leave the machine for a remote device — an egress side
+	// effect, same approval tier as exec/computer input.
+	readonly approval = "exec" as const;
+	readonly loadMode = "essential" as const;
+	readonly intent = "optional" as const;
+
+	static createIf(session: ToolSession): RigDeliverTool | null {
+		return bridgeFromEnv() ? new RigDeliverTool(session) : null;
+	}
+
+	constructor(private readonly session: ToolSession) {}
+
+	async execute(
+		_toolCallId: string,
+		params: RigDeliverParams,
+		signal?: AbortSignal,
+		_onUpdate?: AgentToolUpdateCallback<RigDeliverDetails>,
+	): Promise<AgentToolResult<RigDeliverDetails>> {
+		throwIfAborted(signal);
+		const bridge = bridgeFromEnv();
+		if (!bridge) {
+			return {
+				content: [{ type: "text", text: "rig_deliver unavailable: OMPD_WS/OMPD_TOKEN not set" }],
+				details: { path: params.path, ok: false, reply: {} },
+				isError: true,
+			};
+		}
+		const stat = await bridge.request({
+			type: "rig.fs.stat",
+			path: params.path,
+			...(params.cwd ? { cwd: params.cwd } : {}),
+		});
+		throwIfAborted(signal);
+		if (stat.type === "error" || stat.ok === false || stat.exists !== true || stat.kind !== "file") {
+			const why =
+				stat.exists === false
+					? "file does not exist"
+					: stat.kind && stat.kind !== "file"
+						? `path is a ${String(stat.kind)}, not a file`
+						: typeof stat.error === "string"
+							? stat.error
+							: "stat failed";
+			return {
+				content: [{ type: "text", text: `rig_deliver ${params.path}: ${why}` }],
+				details: { path: params.path, ok: false, reply: stat },
+				isError: true,
+			};
+		}
+		const resolved = typeof stat.path === "string" ? stat.path : params.path;
+		const payload: JsonObj = {
+			type: "rig.deliver",
+			path: resolved,
+			name: resolved.split("/").pop() || resolved,
+			size: typeof stat.size === "number" ? stat.size : null,
+			mtimeMs: typeof stat.mtimeMs === "number" ? stat.mtimeMs : null,
+			caption: params.caption ?? "",
+		};
+		const content: TextContent[] = [{ type: "text", text: JSON.stringify(payload) }];
+		return { content, details: { path: resolved, ok: true, reply: payload }, isError: false };
+	}
+}
